@startuml
title App erstellen (Backend-Flow – Git-Link erforderlich)

actor "User" as User
participant "Frontend\n[Container: React]" as Frontend
participant "Backend API\n[Container: FastAPI]" as Backend
participant "Git Repository\n[External System]" as Git
database "PostgreSQL\n[Container: Database]" as Database

User -> Frontend: Klick "App erstellen"
activate Frontend
Frontend -> Backend: POST /apps
activate Backend

Backend -> Backend: get_current_user_keycloak()

Backend -> Git: verify_repository_access(git_link)
activate Git

alt Zugriff erlaubt
    Git --> Backend: success
else Zugriff nicht erlaubt
    Git -> Git: Invitation annehmen
    Git -> Git: Erneut Zugriff prüfen
    alt Zugriff nach Einladung erfolgreich
        Git --> Backend: success
    else Zugriff weiterhin verweigert
        Git --> Backend: failure
        deactivate Git
        Backend --> Frontend: 403 Forbidden
        deactivate Backend
        Frontend -> User: Fehler: Kein Zugriff auf Repository
        deactivate Frontend
        return
    end
end

deactivate Git

Backend -> Database: create_app()
activate Database
activate Backend
Database --> Backend: app object
deactivate Database

Backend --> Frontend: 201 Created\nAppResponse
deactivate Backend
activate Frontend

Frontend -> User: Erfolgsmeldung + App-Details anzeigen
deactivate Frontend

@enduml
