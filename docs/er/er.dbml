// ACHTUNG: Stand vor Postgres-Queue (.github#5) und Entfernung des OpenStack-VM-Pfads (.github#12).
// Es fehlen u. a. task_events, die Freigabe-/Runtime-Spalten und outputs_enc; celeryTaskId und tf_state gibt es nicht mehr.
// Aktuelles Schema: backend/claude_docs/architecture/database.md und backend/app/models.py. Diagramm neu erzeugen.
// ER-Diagramm basierend auf aktueller Datenbankstruktur

Table users {
  userId uuid [primary key]
  email varchar [not null]
  username varchar [not null]
  role varchar [not null, note: 'USER-DEFINED type']
  courseId uuid [ref: > courses.courseId]
  created_at timestamp
  keycloak_id varchar
}

Table courses {
  courseId uuid [primary key]
  name varchar [not null]
}

Table apps {
  appId uuid [primary key]
  name varchar [not null]
  description varchar
  image bytea
  git_link varchar
  userId uuid [not null, ref: > users.userId]
  created_at timestamp
}

Table deployments {
  deploymentId uuid [primary key]
  name varchar [not null]
  userInputVar text
  userId uuid [not null, ref: > users.userId]
  appId uuid [not null, ref: > apps.appId]
  releaseTag varchar
}

Table tasks {
  taskId uuid [primary key]
  deploymentId uuid [not null, ref: > deployments.deploymentId]
  celeryTaskId varchar [not null]
  type varchar [not null, note: 'USER-DEFINED type']
  status varchar [note: 'USER-DEFINED type']
  started_at timestamp
  finished_at timestamp
  logs text
  tf_state text
  outputs text
  created_at timestamp
}

Table teams {
  teamId uuid [primary key]
  name varchar [not null]
  deploymentId uuid [not null, ref: > deployments.deploymentId]
}

Table user_to_deployments {
  userToDeploymentId uuid [primary key]
  userId uuid [not null, ref: > users.userId]
  deploymentId uuid [not null, ref: > deployments.deploymentId]
  
  indexes {
    (userId, deploymentId) [unique, note: 'Verhindert doppelte Zuweisungen']
  }
}

Table user_to_teams {
  userToTeamId uuid [primary key]
  userId uuid [not null, ref: > users.userId]
  teamId uuid [not null, ref: > teams.teamId]
  
  indexes {
    (userId, teamId) [unique, note: 'Verhindert doppelte Zuweisungen']
  }
}

// Kardinalitäten und Relationen:
// 
// users 1:n courses (many users können zu einem course gehören)
// users 1:n apps (ein user kann viele apps erstellen)
// users 1:n deployments (ein user kann viele deployments erstellen)
// apps 1:n deployments (eine app kann viele deployments haben)
// deployments 1:n tasks (ein deployment kann viele tasks haben)
// deployments 1:n teams (ein deployment kann viele teams haben)
// users n:m deployments (via user_to_deployments - zusätzliche Zugriffskontrolle)
// users n:m teams (via user_to_teams - Teammitgliedschaften)
//
// Hauptunterschiede zum alten Schema:
// - userGroup wurde entfernt
// - courseToUserGroup wurde entfernt
// - userToUserGroup wurde entfernt
// - teams referenziert jetzt direkt deployments statt userGroups
// - user_to_deployments ermöglicht n:m Beziehung zwischen users und deployments
// - tasks Tabelle neu hinzugefügt für Celery Task-Tracking
// - alembic_version für Datenbank-Migrationen
