@startuml Pre-Deployment Process

!define C4Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Pre-Deployment Process - Sequence Diagram

actor "User" as User
participant "Frontend\n[Container: React]" as Frontend
participant "Backend API\n[Container: FastAPI]" as Backend
database "PostgreSQL\n[Container: Database]" as Database
participant "Git Service\n[Backend Component]" as GitService
participant "Git Repository\n[External System]" as Git

== Load Available Apps ==

User -> Frontend: Navigate to\n"Create Deployment" page
activate Frontend

Frontend -> Backend: GET /apps
activate Backend

Backend -> Backend: get_current_user_keycloak()

Backend -> Database: get_apps()
activate Database
note right
  Students: only assigned apps
  Teachers/Admins: all apps
end note
Database --> Backend: app list
deactivate Database

Backend --> Frontend: AppResponse[]
deactivate Backend

Frontend --> User: Display available apps
deactivate Frontend

== Select App and Load Versions ==

User -> Frontend: Select app from list
activate Frontend

Frontend -> Backend: GET /apps/{app_id}
activate Backend

Backend -> Backend: get_current_user_keycloak()

Backend -> Database: get_app()
activate Database
Database --> Backend: app object
deactivate Database

alt app has git_link

Backend -> GitService: get_versions(git_link)
activate GitService

GitService -> GitService: parse_git_url(git_link)
note right
  Extracts:
  - host, owner, repo
  - platform (github/gitlab)
end note

alt platform is GitHub

GitService -> Git: GET /repos/{owner}/{repo}/tags
activate Git
Git --> GitService: tags list
deactivate Git

GitService -> Git: GET /repos/{owner}/{repo}/releases
activate Git
Git --> GitService: releases list
deactivate Git

else platform is GitLab

GitService -> Git: GET /api/v4/projects/{project}/repository/tags
activate Git
Git --> GitService: tags list
deactivate Git

GitService -> Git: GET /api/v4/projects/{project}/releases
activate Git
Git --> GitService: releases list
deactivate Git

end

GitService -> GitService: merge tags and releases
note right
  Combines
  - tags: {version, commit, type}
  - releases: {name, description,
    author, published_at, prerelease, htmlurl}
  into unified versions[]
end note

GitService --> Backend: versions[]
deactivate GitService

Backend -> Backend: app.versions = versions[]

Backend --> Frontend: AppWithVersions
deactivate Backend

Frontend --> User: Display app with\navailable versions
deactivate Frontend

== Select Version and Load Variables ==

User -> Frontend: Select version
activate Frontend

Frontend -> Backend: GET /apps/{app_id}/variables\n?version={version}\n(und GET /apps/{app_id}/runtime)
activate Backend

Backend -> Backend: get_current_user_keycloak()

Backend -> Database: get_app()
activate Database
Database --> Backend: app object
deactivate Database

Backend -> GitService: Version am Commit lesen\n(sparse clone, nur appstore.yaml)
activate GitService

GitService -> Git: git fetch (anonym, öffentliches Repository)\nsparse checkout: appstore.yaml
activate Git
Git --> GitService: repo_path (local)
deactivate Git

GitService --> Backend: repo_path
deactivate GitService

Backend -> Backend: app_spec.read_spec_from_repo()\nappstore.yaml parsen und gegen die\nPlattform-Grenzen prüfen
note right
  Fehlt die Datei: 422 appstore_yaml_missing
  Ungültig: 422 mit Feldpfaden (errors)
  Ergebnis: Runtime (kubernetes | kubevirt-vm),
  Scope, Ressourcen-/Netzwerkwahl, Zugang
end note

Backend -> Backend: spec_variables()
note right
  Je Variable aus appstore.yaml:
  - name, type (string | enum | file)
  - default, values (enum)
  - scope (deployment | team)
  - Dateiendungen (file)
end note

Backend -> Backend: cleanup_repository()

Backend --> Frontend: variables[]
deactivate Backend

Frontend --> User: Display dynamic\nvariable input form
deactivate Frontend

== Search Users ==

User -> Frontend: Search for users\nto add to team
activate Frontend

Frontend -> Backend: GET /users/search\n?query={search_term}&limit=10
activate Backend

Backend -> Backend: get_current_user_keycloak()

Backend -> Database: search_users(\nquery, limit)
activate Database
Database --> Backend: matching users
deactivate Database

Backend --> Frontend: User[]
deactivate Backend

Frontend --> User: Display search results
deactivate Frontend

@enduml
